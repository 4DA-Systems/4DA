{"id":"GHSA-q445-7m23-qrmw","summary":"openssl's `MemBio::get_buf` has undefined behavior with empty buffers","details":"Previously, `MemBio::get_buf` called `slice::from_raw_parts` with a null-pointer, which violates the functions invariants, leading to undefined behavior. In debug builds this would produce an assertion failure. This is now fixed.\n","aliases":["RUSTSEC-2024-0357"],"modified":"2026-09-10T03:50:16.826604285Z","published":"2024-07-22T17:34:53Z","database_specific":{"github_reviewed_at":"2024-07-22T17:34:53Z","nvd_published_at":null,"cwe_ids":["CWE-476"],"severity":"MODERATE","github_reviewed":true},"references":[{"type":"WEB","url":"https://github.com/sfackler/rust-openssl/pull/2266"},{"type":"WEB","url":"https://github.com/sfackler/rust-openssl/commit/aef36e0f3950653148d6644309ee41ccf16e02bb"},{"type":"PACKAGE","url":"https://github.com/sfackler/rust-openssl"},{"type":"WEB","url":"https://github.com/sfackler/rust-openssl/releases/tag/openssl-v0.10.66"},{"type":"WEB","url":"https://rustsec.org/advisories/RUSTSEC-2024-0357.html"}],"affected":[{"package":{"name":"openssl","ecosystem":"crates.io","purl":"pkg:cargo/openssl"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"0.10.66"}]}],"database_specific":{"source":"https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2024/07/GHSA-q445-7m23-qrmw/GHSA-q445-7m23-qrmw.json"}}],"schema_version":"1.9.0","severity":[{"type":"CVSS_V3","score":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:L/A:L"},{"type":"CVSS_V4","score":"CVSS:4.0/AV:N/AC:L/AT:N/PR:N/UI:N/VC:N/VI:L/VA:L/SC:N/SI:N/SA:N"}]}
