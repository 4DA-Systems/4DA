[Desktop Entry]
Categories={{categories}}
Comment={{comment}}
Exec={{exec}} %U
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
StartupWMClass=fourda
Keywords=developer;intelligence;curation;signals;privacy;local;
MimeType=x-scheme-handler/fourda;
Actions=signal-terminal;

[Desktop Action signal-terminal]
Name=Open Signal Terminal
Exec={{exec}} --signal-terminal
