#!/bin/sh
# CADE Pre-push Hook — thorough gate
# Runs full validation before allowing push to remote

echo "Running CADE pre-push validation..."

# ── Path-aware gating ──────────────────────────────────────────────────────
# The two heavy local checks (full frontend tests, cargo clippy) are an exact
# duplicate of jobs that now run as REQUIRED, branch-protected CI gates
# (.github/workflows/validate.yml). Run them locally ONLY when their files
# changed; the fast checks (fmt, translations, compound-quality, audits, secret
# scan) always run. CI stays the authoritative gate — this just removes
# redundant local waits on unrelated pushes (e.g. a Rust-only or docs-only push
# no longer pays the ~5-min frontend suite + cold clippy). Conservative: if the
# diff base can't be determined, every heavy check runs (safe default).
CHANGED=""
if BASE=$(git merge-base origin/main HEAD 2>/dev/null) && [ -n "$BASE" ]; then
    CHANGED=$(git diff --name-only "$BASE"...HEAD 2>/dev/null)
fi
if [ -z "$CHANGED" ]; then
    FE_CHANGED=1
    RUST_CHANGED=1
    echo "Pre-push: change range unknown — running all checks."
else
    if echo "$CHANGED" | grep -qE '^(src/|package\.json|pnpm-lock\.yaml|index\.html|vite\.config\.|tsconfig.*json|tailwind\.config\.|public/|scripts/)'; then FE_CHANGED=1; else FE_CHANGED=0; fi
    if echo "$CHANGED" | grep -qE '^src-tauri/'; then RUST_CHANGED=1; else RUST_CHANGED=0; fi
fi

# TypeScript type check (fresh, no incremental — catches stale cache issues)
if [ "$FE_CHANGED" = "1" ]; then
    echo "Checking TypeScript types..."
    node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit || {
        echo "TypeScript check failed. Fix type errors before pushing."
        exit 1
    }

    # Full frontend tests (CI's Frontend job is the required gate; this is fast feedback)
    echo "Running frontend tests..."
    NODE_OPTIONS="--max-old-space-size=4096" pnpm run test -- --run 2>/dev/null || {
        echo "Frontend tests failed. Fix failing tests before pushing."
        exit 1
    }
else
    echo "Skipping TypeScript + frontend tests (no frontend changes; CI gates them)."
fi

# Rust formatting + lint check — only when src-tauri changed (CI's Rust job is
# the required gate). Skipped on non-Rust pushes to avoid a cold clippy compile.
if [ "$RUST_CHANGED" = "1" ] && [ -f "src-tauri/Cargo.toml" ] && command -v cargo > /dev/null 2>&1; then
    echo "Checking Rust formatting..."
    (cd src-tauri && cargo fmt --check 2>&1) || {
        echo "Rust formatting failed. Run 'cd src-tauri && cargo fmt' then re-push."
        exit 1
    }
    echo "Checking Rust compilation + Clippy..."
    (cd src-tauri && cargo clippy --lib 2>&1) || {
        echo "Rust Clippy check failed. Fix deny-level lint violations before pushing."
        exit 1
    }
fi

# Site build verification (catches Eleventy/Vercel failures before push)
echo "Verifying site build..."
if [ -d "site" ] && [ -f "site/package.json" ]; then
    (cd site && npx @11ty/eleventy --dryrun) 2>&1 || {
        echo "Site build failed. Fix site errors before pushing."
        exit 1
    }
fi

# Translation completeness check
echo "Validating translations..."
node scripts/validate-translations.cjs --quiet 2>/dev/null || {
    echo "Translation validation failed. Run 'pnpm run validate:translations' for details."
    # Warn only, don't block
}

# Compound quality check — ensures every change leaves the codebase strictly better
echo "Running compound quality check..."
node scripts/compound-quality-check.cjs || {
    echo "Compound quality check failed. Fix issues before pushing."
    exit 1
}

# Dependency vulnerability check
echo "Checking npm dependencies for vulnerabilities..."
pnpm audit --audit-level=critical 2>/dev/null || {
    echo ""
    echo "CRITICAL npm vulnerabilities found. Review with 'pnpm audit' before pushing."
    echo "If these are known/accepted, document in .ai/DECISIONS.md and use 'git push --no-verify'"
    echo ""
    # Don't block push for this — just warn loudly
    # exit 1
}

# Rust dependency audit (if cargo-audit is installed)
if command -v cargo-audit > /dev/null 2>&1; then
    echo "Checking Rust dependencies for vulnerabilities..."
    (cd src-tauri && cargo audit --deny warnings 2>/dev/null) || {
        echo ""
        echo "Rust dependency vulnerabilities found. Review with 'cargo audit'."
        echo ""
    }
fi

# Secret scan — defense-in-depth (catches secrets added via --no-verify)
#
# The flat regex alternation that used to be duplicated here is gone. The patterns
# live ONCE in scripts/scan-secrets.cjs (shared with .husky/pre-commit); this hook
# still owns the RANGE logic below, because which commits a push contributes is
# push-protocol-specific. `--diff-added` reads the `git log -p` stream on stdin and
# scans only ADDED (`+`) lines using the high-confidence pattern subset — the same
# subset, with no exclude filters, that the old alternation encoded.
echo "Scanning for secrets in push range..."

REMOTE="$1"
URL="$2"
while read LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" != "0000000000000000000000000000000000000000" ]; then
        # Scan exactly the commits this push contributes — no more, no less.
        #
        # `--not origin/main` is what bounds it. Commits already on origin/main
        # are published; this hook cannot unpublish them, and judging them only
        # blocks legitimate pushes. Without the exclusion the range silently
        # widens after a rebase — the old remote tip stops being an ancestor, so
        # `$REMOTE_SHA..$LOCAL_SHA` pulls in main's whole history since the
        # branch forked. Measured on a 2026-07-15 branch rebased onto today's
        # main: 85 commits scanned instead of 1, and the private-asset guard
        # below then blocked the force-push on findings that live in main's own
        # commit messages. A stale branch could not be updated at all.
        if git rev-parse -q --verify origin/main >/dev/null 2>&1; then
            EXCLUDE_PUBLISHED="--not origin/main"
        else
            # No origin/main to compare against (fresh clone, fork, first push):
            # fall back to scanning everything rather than scanning nothing.
            EXCLUDE_PUBLISHED=""
        fi
        if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
            # New branch — every commit not already published.
            RANGE="$LOCAL_SHA"
        else
            RANGE="$REMOTE_SHA..$LOCAL_SHA"
        fi
        # `git log -p` walks the pushed COMMITS. The previous `git diff "$RANGE"`
        # was wrong in both directions: with a single-SHA range it is not a range
        # at all — `git diff <commit>` compares that commit to the WORKING TREE,
        # so on the normal path (clean tree, pushing the branch you are standing
        # on) it produced an empty diff and the secret scan inspected 0 bytes on
        # every new-branch push; and when pushing a branch that is not checked
        # out it scanned a large unrelated diff instead. Walking commits also
        # catches a secret that was added and later removed in the same push,
        # which a net diff misses entirely.
        # shellcheck disable=SC2086 # RANGE/EXCLUDE_PUBLISHED must word-split into git args
        if ! git log -p -n 2000 --no-color $RANGE $EXCLUDE_PUBLISHED -- ':!site/src/contact.njk' ':!site/src/privacy.njk' ':!site/src/terms.njk' 2>/dev/null \
            | node scripts/scan-secrets.cjs --diff-added; then
            echo ""
            echo "============================================================"
            echo "  PUSH BLOCKED — Secrets detected in commits!"
            echo "============================================================"
            echo ""
            echo "Remove secrets, amend/rebase commits, and force-push clean history."
            echo "Run: node scripts/scan-secrets.cjs  (for full repo audit)"
            exit 1
        fi

        # Private-asset leak scan — blocks pushing any outgoing commit (message OR content) that names the
        # private external verifier. Complements .husky/commit-msg (which only guards new local messages) and
        # backstops the 2026-07-13 public-history scrub: a branch based on PRE-SCRUB history is blocked here so
        # it cannot re-upload the old commits. Detection is HASHED in scripts/private-asset-guard.cjs (no literal
        # name lives in this hook). FAIL-OPEN on any tool error — never brick the fleet's ability to push; block
        # ONLY on a positive detection. Bypass (emergencies only): git push --no-verify.
        if command -v node > /dev/null 2>&1 && [ -f scripts/private-asset-guard.cjs ]; then
            # Same bounded range as the secret scan above: only this push's own
            # commits. See the comment there for why `--not origin/main` matters.
            # strip the leading diff marker (+/-) so a line-leading addition doesn't glue to a flagged name
            # shellcheck disable=SC2086 # RANGE/EXCLUDE_PUBLISHED must word-split into git args
            git log -p -n 2000 --no-color $RANGE $EXCLUDE_PUBLISHED 2>/dev/null | sed 's/^[-+]//' | node -e 'try{const {scanText}=require("./scripts/private-asset-guard.cjs");let s="";process.stdin.on("data",d=>s+=d);process.stdin.on("end",()=>{try{process.exit(scanText(s)?1:0)}catch(e){process.exit(0)}})}catch(e){process.exit(0)}'
            if [ $? -ne 0 ]; then
                echo ""
                echo "============================================================"
                echo "  PUSH BLOCKED — private external-verifier reference in commits!"
                echo "============================================================"
                echo "  This usually means the branch is based on PRE-SCRUB history."
                echo "  Rebase onto the current origin/main, then re-push:"
                echo "    git fetch origin && git rebase --onto origin/main \$(git merge-base HEAD <old-base>) HEAD"
                echo "  Details: .claude/plans/FLEET-RESYNC-2026-07-13.md"
                exit 1
            fi
        fi
    fi
done
echo "Pre-push validation passed!"
