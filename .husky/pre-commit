#!/bin/sh
# CADE Pre-commit Hook — fast gate
# Runs: file sizes, cargo fmt, IPC contracts, ESLint, tsc (incremental), secrets
# Process-aware: skips heavy ops when dev server is running to prevent crashes

echo "Running CADE pre-commit validation..."

# Detect if Tauri dev server or heavy cargo processes are running
# On Windows, tasklist is used; on Unix, ps aux
DEV_SERVER_RUNNING=false
CARGO_BUSY=false

if command -v tasklist > /dev/null 2>&1; then
    # Windows: check for cargo.exe processes (dev server runs cargo-tauri)
    if tasklist //FI "IMAGENAME eq cargo.exe" 2>/dev/null | grep -q "cargo.exe"; then
        CARGO_BUSY=true
    fi
    # Check for the vite/tauri dev server
    if tasklist //FI "IMAGENAME eq cargo-tauri.exe" 2>/dev/null | grep -q "cargo-tauri"; then
        DEV_SERVER_RUNNING=true
    fi
else
    # Unix: check for cargo processes
    if pgrep -f "cargo-tauri dev" > /dev/null 2>&1; then
        DEV_SERVER_RUNNING=true
    fi
    if pgrep -f "cargo build\|cargo check\|cargo test" > /dev/null 2>&1; then
        CARGO_BUSY=true
    fi
fi

if [ "$DEV_SERVER_RUNNING" = true ] || [ "$CARGO_BUSY" = true ]; then
    echo "[GUARD] Heavy processes detected — running lightweight pre-commit only"
fi

# File size guardian (fast check, ~1s) — always runs
echo "Checking file sizes..."
node scripts/check-file-sizes.cjs || {
    echo "File size check failed. Split large files or add justified exceptions."
    exit 1
}

# Doc-location gate (fast check, <1s) — always runs
# Blocks internal planning docs from being committed at repo root.
# See .claude/rules/document-hygiene.md for the framework.
echo "Checking doc locations..."
node scripts/check-doc-location.cjs || exit 1

# LLM-gate honesty (fast check, <1s) — always runs
# Blocks new "configured/available" checks derived from key-presence or a
# single-provider OR-shortcut. See antibody 2026-06-02-proxy-derived-state.md.
echo "Checking LLM-gate honesty..."
node scripts/check-llm-gate-honesty.cjs || exit 1

# Vanity-metrics gate (fast check, <1s) — always runs
# Blocks banned vanity counters (Items monitored / Decisions tracked: 0 / ...).
# See .claude/rules/intelligence-doctrine.md rule 3.
echo "Checking for vanity metrics..."
node scripts/check-vanity-metrics.cjs || exit 1

# Release-channel integrity (fast check, <1s) - always runs
# Blocks updater endpoint drift, missing latest.json release gates, and MCP
# releases becoming GitHub's global latest release.
echo "Checking release channel integrity..."
node scripts/check-release-channel.cjs || exit 1

# Dead code expiry enforcement — #[allow(dead_code)] must have a REMOVE BY date
# Ghost command detection — commands in Rust with no frontend caller
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
if [ -n "$STAGED_RS" ]; then
    # --- No-window spawn gate (fast whole-tree scan) ---
    # Every Windows-reachable Command::new MUST suppress the console window
    # (CREATE_NO_WINDOW) or a black window flashes on the user's desktop — reads
    # as malware. See .ai/INVARIANTS.md INV-043.
    echo "Checking for console-window-flashing spawns..."
    node scripts/check-no-window-spawns.cjs || exit 1

    # --- Dead Code Expiry Check ---
    # Node implementation: the previous inline loop forked a grep PER LINE of every
    # staged file carrying an annotation, which on Windows/cygwin took tens of
    # minutes once a 5k-line file was staged (see scripts/check-dead-code-expiry.cjs).
    echo "Checking dead_code expiry annotations..."
    node scripts/check-dead-code-expiry.cjs || exit 1

    # --- Ghost Command Detection ---
    # Blocks NEW ghosts (registered command, no frontend caller). Pre-existing
    # ghosts are allowlisted in scripts/ghost-command-backlog.json and reported
    # as a loud backlog line below — never silently swallowed.
    echo "Checking for ghost commands..."
    GHOST_OUT=$(node scripts/ghost-commands.cjs 2>&1) || {
        echo ""
        echo "$GHOST_OUT" | sed -n '/GHOST (NEW)/,/^$/p'
        echo "New ghost command(s) detected — registered in Rust with no frontend caller."
        echo "Wire it up in the frontend, or delete it from Rust + generate_handler![]"
        echo "+ the CommandMap. Run 'node scripts/ghost-commands.cjs' for details."
        echo ""
        exit 1
    }
    echo "$GHOST_OUT" | grep "DEAD IPC BACKLOG" || true
fi

# Rust formatting (fast check, ~2s) — skip if cargo is busy or modules missing
if [ "$CARGO_BUSY" = true ]; then
    echo "Skipping cargo fmt check (cargo processes active — will check on push)"
else
    echo "Checking Rust formatting..."
    cd src-tauri && cargo fmt --check 2>&1 || {
        if cargo fmt --check 2>&1 | grep -q "does not exist"; then
            echo "Skipping cargo fmt (missing module stubs — will check on push)"
        else
            echo "Rust formatting check failed. Run 'cargo fmt' to fix."
            exit 1
        fi
    }
    cd ..
fi

# IPC contract validation (~1s) — runs when .rs or commands.ts files are staged
STAGED_RS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
STAGED_CMD=$(git diff --cached --name-only --diff-filter=ACM | grep 'commands.ts' || true)
if [ -n "$STAGED_RS" ] || [ -n "$STAGED_CMD" ]; then
    echo "Validating IPC contracts..."
    node scripts/validate-commands.cjs > /dev/null 2>&1 || {
        echo ""
        echo "IPC contract validation failed! Ghost commands detected."
        echo "Run 'pnpm run validate:commands' for details."
        echo ""
        exit 1
    }
fi

# Boundary-call validation (~1s) — runs when .rs or hook files are staged
# Layer 2 of the Silent-Failure Defense Architecture (see docs/strategy/SILENT-FAILURE-DEFENSE.md).
# Informational only for now — won't block until the 48-site migration backlog is cleared.
# Once backlog is <= 5, switch to: node scripts/validate-boundary-calls.cjs --strict || exit 1
STAGED_HOOKS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cjs|sh)$' || true)
if [ -n "$STAGED_RS" ] || [ -n "$STAGED_HOOKS" ]; then
    echo "Checking boundary calls (silent-failure defense)..."
    node scripts/validate-boundary-calls.cjs 2>/dev/null || true
fi

# ESLint on staged files only (~3s vs full project ~8s) — always runs (lightweight)
# Needs extra memory for type-checked linting (no-floating-promises, no-misused-promises)
echo "Running ESLint (staged files)..."
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)
if [ -n "$STAGED_TS" ]; then
    export NODE_OPTIONS="--max-old-space-size=8192"
    echo "$STAGED_TS" | xargs node_modules/.bin/eslint --no-warn-ignored 2>/dev/null || {
        echo "ESLint check failed. Fix lint errors before committing."
        exit 1
    }
    unset NODE_OPTIONS
fi

# TypeScript dead code detection (knip, ~3s) — warning only, does not block
if [ -n "$STAGED_TS" ]; then
    KNIP_OUT=$(npx knip --no-progress --include files 2>/dev/null || true)
    KNIP_COUNT=$(echo "$KNIP_OUT" | grep -c "Unused files" 2>/dev/null || echo "0")
    if [ "$KNIP_COUNT" -gt 0 ]; then
        echo "[WARN] knip detected unused TypeScript files. Run 'npx knip' for details."
    fi
fi

# TypeScript type checking (incremental for speed, ~3-8s) — only when .ts/.tsx files are staged
if [ -n "$STAGED_TS" ]; then
    if [ "$DEV_SERVER_RUNNING" = true ]; then
        echo "TypeScript check (dev server running — may be slower)..."
    else
        echo "Checking TypeScript types (incremental)..."
    fi
    node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit --incremental --tsBuildInfoFile .tsbuildinfo 2>&1 || {
        echo "TypeScript type check failed. Fix type errors before committing."
        exit 1
    }
fi

# Translation coverage check (non-blocking — shows summary, doesn't fail)
# Detects missing keys, variable mismatches, orphaned namespaces
STAGED_LOCALE=$(git diff --cached --name-only --diff-filter=ACM | grep -E 'locales/.*\.json$' || true)
if [ -n "$STAGED_LOCALE" ]; then
    echo "Checking translation coverage..."
    node scripts/validate-translations.cjs --summary 2>/dev/null || true
fi

# i18n Guard — blocks defaultValue bypasses, warns on missing translations
node scripts/i18n-guard.cjs 2>/dev/null || {
    echo "i18n guard failed. Remove defaultValue usage — use locale files instead."
    exit 1
}

# Secret scanning — comprehensive, nukeproof detection
# Blocks commits containing real API keys, tokens, private keys, PII, and credentials.
#
# The ~180 lines of inline `scan_pattern` greps that used to live here are gone.
# Patterns, the staged-file skip list, and the statutory ABN/phone exemptions are
# now maintained ONCE in scripts/scan-secrets.cjs and shared with .husky/pre-push.
# `--staged` scans STAGED blob content (`git show :FILE`), not the working tree —
# identical semantics to the old inline loop, so a secret that was `git add`ed and
# then edited out of the file still blocks the commit.
echo "Scanning for secrets..."
node scripts/scan-secrets.cjs --staged || {
    echo ""
    echo "============================================================"
    echo "  COMMIT BLOCKED — Secrets/sensitive data detected!"
    echo "============================================================"
    echo ""
    echo "Fix: remove the secret, use environment variables, or add"
    echo "     the value to data/settings.json (gitignored)."
    echo ""
    echo "False positive? Adjust STAGED_EXCLUDE (skip a file) or the"
    echo "     per-pattern exemptions in scripts/scan-secrets.cjs,"
    echo "     or use a clearly fake value."
    echo ""
    echo "DANGEROUS bypass: git commit --no-verify"
    exit 1
}

# Cargo sweep — prune build artifacts older than 7 days
# Prevents target/ from growing unbounded (80+ GB incremental cache observed)
if command -v cargo-sweep > /dev/null 2>&1; then
    echo "Sweeping stale build artifacts..."
    (cd src-tauri && cargo sweep --time 7 2>/dev/null || true)
fi

echo "Pre-commit validation passed! (full tests run on push)"
