{
  "mcpServers": {
    "4da": {
      "args": [
        "./mcp-4da-server/dist/index.js"
      ],
      "command": "node",
      "env": {
        "FOURDA_DB_PATH": "./data/4da.db"
      }
    },
    "memory": {
      "args": [
        "./mcp-memory-server/dist/index.js"
      ],
      "command": "node",
      "env": {
        "MEMORY_DB_PATH": "./.claude/memory.db"
      }
    },
    "playwright": {
      "args": [
        "@playwright/mcp@latest"
      ],
      "command": "npx"
    },
    "external-verifier": {
      "args": [
        "mcp"
      ],
      "command": "D:\\dev-cache\\.cargo\\bin\\external-verifier.exe",
      "env": {
        "[redacted-url]": "http://127.0.0.1:7575",
        "[redacted-token]": "[redacted-token-value]"
      }
    },
    "victauri": {
      "_comment": "Victauri MCP â€” stdio bridge to running 4DA dev server",
      "args": [
        "bridge",
        "--wait"
      ],
      "command": "victauri"
    }
  }
}