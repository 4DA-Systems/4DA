{
  "name": "4da-site",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "build": "pnpm run clean && eleventy",
    "dev": "eleventy --serve",
    "cf:dev": "wrangler pages dev",
    "cf:deploy": "pnpm run build && wrangler pages deploy",
    "verify:ed25519": "node scripts/verify-ed25519-equivalence.mjs",
    "test:lease": "node scripts/test-lease.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "^2",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3",
    "wrangler": "^4"
  },
  "pnpm": {
    "overrides": {
      "liquidjs": ">=10.27.1",
      "markdown-it": ">=14.2.0 <15",
      "linkify-it": ">=5.0.2 <6",
      "ws": ">=8.21.0 <9",
      "picomatch@2": ">=2.3.2 <3",
      "minimatch@>=9.0.0 <9.0.6": ">=9.0.7",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.0.3": ">=2.0.3",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9 <6",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "nanoid@>=4.0.0 <5.1.16": ">=5.1.16 <6",
      "postcss@<8.5.23": ">=8.5.23 <9",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8"
    }
  }
}
