  <p style="font-size:13px;color:var(--text-muted);">All measurements are manufacturer specifications for the blank garments, laid flat. Print placement does not affect fit. Still unsure? <a href="/contact">Ask us</a> before you order — we're happy to help you dial it in.</p>

  <script>
    (function() {
      var btns = document.querySelectorAll('.unit-btn');
      function setUnit(unit) {
        document.querySelectorAll('[data-unit-table] td[data-in]').forEach(function(td) {
          td.textContent = td.getAttribute('data-' + unit);
        });
        btns.forEach(function(b) { b.classList.toggle('active', b.dataset.unit === unit); });
      }
      btns.forEach(function(b) { b.addEventListener('click', function() { setUnit(b.dataset.unit); }); });
    })();
  </script>
